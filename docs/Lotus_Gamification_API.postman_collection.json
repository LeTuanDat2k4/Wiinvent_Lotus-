							"raw": "{{baseUrl}}/api/v1/check-ins/status",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"check-ins",
								"status"
							]
						}
					}
				},
				{
					"name": "API 4 - Perform Check-in",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{userAccessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/check-ins",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
