		{
			"name": "Points",
			"item": [
				{
					"name": "API 5 - Point History",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{userAccessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/points/history?page=0&size=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"points",
								"history"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								}
							]
						}
					}
				},
				{
					"name": "API 6 - Deduct Point",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{adminAccessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 5,\n  \"reason\": \"Redeem reward voucher\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/points/deduct",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"points",
								"deduct"
							]
						}
					}
				}
			]
		}
